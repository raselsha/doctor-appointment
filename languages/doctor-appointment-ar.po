#: includes/sms.php:122
msgid "{patient_name}, it is your turn now. Please go to {doctor_name}'s room. - {clinic_name}"
msgstr "{patient_name}، حان دورك الآن. يُرجى التوجه إلى غرفة {doctor_name}. - {clinic_name}"

#: includes/sms.php:125
msgid "Visit completed"
msgstr "اكتملت الزيارة"

#: includes/sms.php:126
msgid "Sent after the visit is marked complete."
msgstr "تُرسل بعد تحديد الزيارة كمكتملة."

#: includes/sms.php:129
msgid "Thank you for visiting {clinic_name}, {patient_name}. Get well soon. For any query: {clinic_contact}"
msgstr "شكرًا لزيارتك {clinic_name}، {patient_name}. نتمنى لك الشفاء العاجل. لأي استفسار: {clinic_contact}"

