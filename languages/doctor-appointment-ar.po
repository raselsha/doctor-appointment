msgstr "{patient_name}، افتقدناك في {clinic_name} يوم {date}. يُرجى التواصل مع {clinic_contact} لإعادة الحجز."

#: includes/sms.php:139
msgid "Rescheduled"
msgstr "تمت إعادة الجدولة"

#: includes/sms.php:140
msgid "Sent when a booking's date or time is changed from the admin panel."
msgstr "تُرسل عند تغيير تاريخ الحجز أو وقته من لوحة الإدارة."

