msgid "New booking: {patient_name} ({patient_phone}) on {date} at {time}. Serial: {ticket}."
msgstr "حجز جديد: {patient_name} ({patient_phone}) يوم {date} الساعة {time}. الدور: {ticket}."

#: includes/sms.php:104
#: includes/sms.php:198
msgid "Appointment reminder"
msgstr "تذكير بالموعد"

#: includes/sms.php:105
msgid "Sent once, a set number of hours before the appointment time. Never sent for a booking that is already checked in, served or cancelled."
msgstr "تُرسل مرة واحدة قبل وقت الموعد بعدد محدد من الساعات. لا تُرسل أبدًا لحجز تم تسجيل وصوله أو خدمته أو إلغاؤه."

#: includes/sms.php:108
msgid "Reminder: {patient_name}, your appointment with {doctor_name} is today at {time}. Serial: {ticket}. - {clinic_name}"
msgstr "تذكير: {patient_name}، موعدك مع {doctor_name} اليوم الساعة {time}. الدور: {ticket}. - {clinic_name}"

#: includes/sms.php:111
msgid "Checked in"
msgstr "تم تسجيل الوصول"

#: includes/sms.php:112
